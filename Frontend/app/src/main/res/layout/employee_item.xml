<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="horizontal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- Indicateur de couleur -->
        <View
            android:id="@+id/viewColorIndicator"
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp" />

        <!-- Numéro employé -->
        <TextView
            android:id="@+id/txtNumEmp"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:textColor="#64B5F6"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:gravity="start"
            android:ellipsize="end" />

        <!-- Nom -->
        <TextView
            android:id="@+id/txtNom"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:maxLines="2"
            android:gravity="start"
            android:ellipsize="end" />

        <!-- Salaire -->
        <TextView
            android:id="@+id/txtSalaire"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:textColor="#B0C4DE"
            android:textSize="14sp"
            android:maxLines="2"
            android:gravity="start"
            android:ellipsize="end" />

        <!-- Catégorie -->
        <TextView
            android:id="@+id/txtCategorie"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Boutons d'action -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:minWidth="72dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/btnEdit"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_edit"
                android:tint="#FFA726"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Modifier" />

            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_delete"
                android:tint="#F44336"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Supprimer" />
        </LinearLayout>
    </LinearLayout>
</HorizontalScrollView>