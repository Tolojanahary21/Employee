<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1929"
    android:padding="16dp"
    tools:context=".HomeActivity">

    <!-- Bouton de retour -->
    <ImageView
        android:id="@+id/backbutton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        android:tint="#FFFFFF"
        android:contentDescription="Retour"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Titre de la page -->
    <TextView
        android:id="@+id/titrePage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="GESTION DES EMPLOYÉS"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/backbutton"
        app:layout_constraintTop_toTopOf="@+id/backbutton"
        app:layout_constraintBottom_toBottomOf="@+id/backbutton" />

    <!-- ScrollView principal -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/backbutton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Carte formulaire d'ajout -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFormulaire"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#1E2A3A"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AJOUTER UN EMPLOYÉ"
                        android:textColor="#64B5F6"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Champ Numéro Employé -->
                    <EditText
                        android:id="@+id/editNumEmp"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Numéro employé (ex: EMP001)"
                        android:textColorHint="#8F9BB3"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/edittext_bg"
                        android:padding="12dp"
                        android:inputType="text"
                        android:layout_marginBottom="10dp" />

                    <!-- Champ Nom -->
                    <EditText
                        android:id="@+id/editNom"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Nom complet"
                        android:textColorHint="#8F9BB3"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/edittext_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Champ Salaire -->
                    <EditText
                        android:id="@+id/editSalaire"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Salaire (Ar)"
                        android:textColorHint="#8F9BB3"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/edittext_bg"
                        android:padding="12dp"
                        android:inputType="numberDecimal"
                        android:layout_marginBottom="16dp" />

                    <!-- Bouton Ajouter -->
                    <Button
                        android:id="@+id/btnAjouter"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="AJOUTER"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1976D2"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Graphique en camembert -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGraph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#1E2A3A"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RÉPARTITION DES SALAIRES"
                        android:textColor="#FFA726"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Conteneur pour le graphique -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <!-- Graphique circulaire personnalisé -->
                        <View
                            android:id="@+id/pieChart"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="#2A3B4C"
                            android:layout_marginEnd="16dp" />

                        <!-- Légende -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp">

                                <View
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:background="#F44336"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Faible (&lt;1000 Ar)"
                                    android:textColor="#B0C4DE"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp">

                                <View
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:background="#FFA726"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Moyen (1000-5000 Ar)"
                                    android:textColor="#B0C4DE"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:background="#4CAF50"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Élevé (&gt;5000 Ar)"
                                    android:textColor="#B0C4DE"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Pourcentages -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/txtPourcentageFaible"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0%"
                            android:textColor="#F44336"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/txtPourcentageMoyen"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0%"
                            android:textColor="#FFA726"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/txtPourcentageEleve"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0%"
                            android:textColor="#4CAF50"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section Statistiques -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#1E2A3A"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STATISTIQUES"
                        android:textColor="#FFA726"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Affichage des stats -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <!-- Total -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOTAL"
                                android:textColor="#8F9BB3"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 Ar"
                                android:textColor="#4CAF50"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Min -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MIN"
                                android:textColor="#8F9BB3"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtMin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 Ar"
                                android:textColor="#F44336"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Max -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MAX"
                                android:textColor="#8F9BB3"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtMax"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 Ar"
                                android:textColor="#FFA726"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Indicateurs visuels pour les catégories -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:weightSum="3">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:background="#F44336"
                            android:gravity="center"
                            android:text="Faible"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginEnd="4dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:background="#FFA726"
                            android:gravity="center"
                            android:text="Moyen"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginEnd="4dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:background="#4CAF50"
                            android:gravity="center"
                            android:text="Élevé"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Message d'info catégories (CORRIGÉ) -->
                    <TextView
                        android:id="@+id/txtInfoCategories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="⚡ Élevé (&gt;5000 Ar) • Moyen (1000-5000 Ar) • Faible (&lt;1000 Ar)"
                        android:textColor="#B0C4DE"
                        android:textSize="11sp"
                        android:gravity="center"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Liste des employés -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardListe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E2A3A"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LISTE DES EMPLOYÉS"
                        android:textColor="#64B5F6"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- En-tête de liste avec scroll horizontal (aligné avec item_employee.xml) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="horizontal"
                        android:fillViewport="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="#2A3B4C"
                            android:gravity="center_vertical"
                            android:padding="8dp">

                            <!-- Espace pour l'indicateur de couleur -->
                            <View
                                android:layout_width="4dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="N°"
                                android:textColor="#64B5F6"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Nom"
                                android:textColor="#64B5F6"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="Salaire"
                                android:textColor="#64B5F6"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:text="Catégorie"
                                android:textColor="#64B5F6"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:text="Actions"
                                android:textColor="#64B5F6"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- ListView des employés -->
                    <ListView
                        android:id="@+id/listViewEmployes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="#2A3B4C"
                        android:dividerHeight="1dp"
                        android:padding="4dp" />

                    <!-- PAGINATION -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="16dp"
                        android:padding="8dp">

                        <Button
                            android:id="@+id/btnPagePrecedente"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="◀ Précédent"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#2A3B4C"
                            android:enabled="false"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/txtPageInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Page 1 / 1"
                            android:textColor="#64B5F6"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginHorizontal="16dp"/>

                        <Button
                            android:id="@+id/btnPageSuivante"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Suivant ▶"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#2A3B4C"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>